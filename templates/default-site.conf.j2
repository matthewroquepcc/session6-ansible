# {{ ansible_managed }}
server {
    listen 80 default_server;
    listen [::]:80 default_server;

    root /var/www/html;
    index index.html;
    server_name _;

    # Hide the nginx version and tag every response
    server_tokens off;
    add_header X-Managed-By "Ansible" always;
    add_header X-Class "Session 6" always;

    location / {
        try_files $uri $uri/ =404;
    }
}
